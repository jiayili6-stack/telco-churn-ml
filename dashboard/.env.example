# =============================================================================
# Optional: AWS RDS configuration
# =============================================================================
# If you want to connect this dashboard to a real AWS RDS MySQL instance,
# copy this file to `.env` and fill in your own credentials.
#
# If you skip this, the app will fall back to a local SQLite database
# (predictions.db) and run with all features intact - no AWS account needed.
#
# DO NOT commit `.env` to git. It is already in .gitignore.
# =============================================================================

RDS_HOST=your-rds-endpoint.xxxxx.us-east-1.rds.amazonaws.com
RDS_USER=admin
RDS_PASSWORD=your-password-here
RDS_DATABASE=telco_churn
